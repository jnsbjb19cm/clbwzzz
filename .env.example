# ---- 服务端 ----
NODE_ENV=production
SERVER_PORT=3001
# 跨域来源，多个用逗号分隔；生产环境同源访问可填 CORS_ALLOW_ALL=true
# 例如局域网: CLIENT_ORIGIN=http://192.168.1.100:3001
CLIENT_ORIGIN=http://localhost:3001
CORS_ALLOW_ALL=false
# 反向代理（Nginx/宝塔）下推荐 true；也可填跳数 1
TRUST_PROXY=true
JWT_SECRET=请在本地.env文件中填写随机密钥
JWT_EXPIRES_IN=7d

# ---- 跨机联机（2026-09-11）----
# 最省事：先 npm run build，再 npm run lan，然后让同一局域网的朋友打开
#   http://<你的局域网IP>:3001/
# 服务器启动时会把可分享的地址打印出来（自动枚举本机局域网 IPv4）。
# 开发模式（热更新）跨机：npm run lan:dev，朋友访问 http://<你的局域网IP>:5173/
#   开发模式下客户端会自动把 API/WS 指向 http://<同一IP>:3001，
#   且开发环境默认放开 CORS（NODE_ENV!=production 时 CORS_ALLOW_ALL 默认 true）。
# 生产环境跨机必须显式设置下面两项之一：
#   CORS_ALLOW_ALL=true           （允许任意来源，适合内网自用）
#   CLIENT_ORIGIN=http://192.168.1.100:3001,http://192.168.1.100:5173

# ---- 房间寿命 ----
# 房间从创建时刻起最多存在多久（毫秒）。不填 = 7200000（2 小时）。
# 服务端会打印创建/解散日志（带时间戳与房间年龄），可据此核对实际寿命：
#   [clbwzzz][room-lifetime] created room=1 expiresIn=120.0min expiresAt=...
#   [clbwzzz][room-lifetime] destroyed room=1 reason=lifetime age=7200.0s limit=120.0min
# ROOM_LIFETIME_MS=7200000

# ---- 数据库 ----
# sqlite 或 mysql。本地/旧开发默认 sqlite；远程/多人使用推荐 mysql
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clbwzzz
DB_USER=root
# 数据库密码三种填法（推荐只保留加密版或密码文件版）：
# 1) 明文（仅本地临时用）
# DB_PASSWORD=你的密码
# 2) 加密后写入（不要明文）
# 用 node scripts/encrypt-db-password.mjs "你的密码" 生成 DB_MASTER_KEY 和 DB_PASSWORD_ENC
# DB_MASTER_KEY=请填写脚本生成的主密钥
# DB_PASSWORD_ENC=v1....
# 3) 从文件读取（服务器上把文件权限设为仅本用户可读，不进 Git）
# DB_PASSWORD_FILE=C:/secure/mysql-password.txt
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000
