{
  "name": "clbwzjb",
  "version": "1.2.1",
  "description": "丛林战纪(保卫战)- JavaScript 重制版",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently -k -n SERVER,CLIENT \"npm:dev:server\" \"npm:dev:client\"",
    "server": "node server/index.js",
    "server:prod": "node server/index.js",
    "build:deploy": "vite build",
    "start:prod": "npm run build:deploy && node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lan": "npm run build:deploy && node server/index.js",
    "lan:dev": "concurrently -k -n SERVER,CLIENT \"npm:dev:server\" \"npm:dev:client\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "1.55.1",
    "atf2png": "^1.1.1",
    "concurrently": "^9.2.0",
    "fast-xml-parser": "^5.2.5",
    "sharp": "^0.35.1",
    "vite": "^6.3.5"
  }
}
